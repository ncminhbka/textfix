# TextFix: biến môi trường (docs/SERVER.md). Nên export trong terminal (~/textfix_env.sh); hoặc chép thành .env (KHÔNG commit).
# Biến đã export thắng .env.

# --- LLM (prompt FLUX + câu khách) và VLM (designer): API OpenAI-compatible (vLLM). Một model nhìn được ảnh làm cả hai.
# TEXTFIX_LLM_URL=http://<host>:<port>/v1
# TEXTFIX_MODEL=<tên model>
# TEXTFIX_LLM_API_KEY=<khoá>
# VLM riêng (không đặt: dùng LLM ở trên)
# TEXTFIX_VLM_URL=
# TEXTFIX_VLM_MODEL=
# TEXTFIX_VLM_API_KEY=
# TEXTFIX_LLM_TIMEOUT=300

# --- FLUX ở MÁY KHÁC (docs/DEPLOY.md): có TEXTFIX_FLUX_URL thì máy chủ không nạp FLUX lên GPU
# TEXTFIX_FLUX_URL=https://api.bfl.ai/v1/flux-2-klein-9b
# TEXTFIX_FLUX_API_KEY=<khoá>
# TEXTFIX_FLUX_CONCURRENCY=2      # số nháp gửi sang cùng lúc
# TEXTFIX_FLUX_TIMEOUT=120
# TEXTFIX_FLUX_SAFETY=2           # safety_tolerance của BFL
# TEXTFIX_HISAM=~/persistent-data/hisam
# TEXTFIX_LAMA=~/persistent-data/lama/big-lama.pt

# --- FLUX.2-klein TẠI CHỖ (khi không đặt TEXTFIX_FLUX_URL)
# TEXTFIX_FLUX=distill            # distill (4 bước, mặc định) | base (50 bước, CFG 4)
# TEXTFIX_WEIGHTS=~/persistent-data/FLUX.2-klein-4B   # tự tìm ở ~/persistent-data/FLUX.2-klein-4B, -base-4B nếu bỏ trống
# TEXTFIX_DEVICE_DIT=cuda:0       # DiT
# TEXTFIX_DEVICE_TE=cuda:1        # bộ mã hoá chữ Qwen3-4B (~8GB): card thứ hai đỡ OOM
# TEXTFIX_DEVICE_AE=cuda:0        # VAE

# --- Dựng HTML
# PLAYWRIGHT_CHROME_PATH=/home/jovyan/persistent-data/chrome-linux64/chrome

# --- Máy chủ
# TEXTFIX_PORT=8088
# TEXTFIX_MAX_RUNS=300

# --- Kho ảnh tham chiếu món / trang phục Việt trên kho đối tượng S3 (docs/KHO.md). Không đặt ENDPOINT: chạy không kho
# TEXTFIX_KHO_ENDPOINT=http://<host>:<cổng API S3>   # cổng API, KHÔNG phải cổng web console
# TEXTFIX_KHO_BUCKET=<bucket>
# TEXTFIX_KHO_PREFIX=textfix-kho/
# TEXTFIX_KHO_ACCESS_KEY=<tài khoản>
# TEXTFIX_KHO_SECRET_KEY=<mật khẩu>
# TEXTFIX_KHO_DIR=output/kho                     # thư mục đệm (mặc định)
