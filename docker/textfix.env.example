# Biến môi trường cho container TextFix demo. Chép thành ~/work/textfix.env (NGOÀI repo, không commit), điền giá trị,
# rồi docker run --env-file ~/work/textfix.env ... (docs/DOCKER.md). Không dùng dấu nháy quanh giá trị.

# FLUX.2 [klein] 9B ở máy khác (bắt buộc: image không chứa FLUX). Hai khuôn API, tự chọn theo đuôi URL:
#  - máy tự host kiểu vLLM-Omni (OpenAI-compatible): URL tận cùng /v1/chat/completions, khoá gửi dạng Bearer
#  - khuôn Black Forest Labs: https://<máy>/v1/flux-2-klein-9b, khoá gửi header x-key
TEXTFIX_FLUX_URL=http://<máy FLUX>/v1/chat/completions
TEXTFIX_FLUX_API_KEY=<khoá>
TEXTFIX_FLUX_CONCURRENCY=2
# chỉ khuôn chat: tên model + tham số vẽ (mặc định như dưới, klein distill 4 bước)
# TEXTFIX_FLUX_MODEL=black-forest-labs/FLUX.2-klein-9B
# TEXTFIX_FLUX_STEPS=4
# TEXTFIX_FLUX_GUIDANCE=1

# LLM (prompt FLUX + danh sách chữ) và VLM (ghép câu vào dòng), OpenAI-compatible
TEXTFIX_LLM_URL=http://<máy LLM>/v1
TEXTFIX_MODEL=<model>
TEXTFIX_LLM_API_KEY=<khoá>
# VLM riêng (bỏ trống: dùng LLM ở trên)
# TEXTFIX_VLM_URL=
# TEXTFIX_VLM_MODEL=
# TEXTFIX_VLM_API_KEY=

# Máy chủ
# TEXTFIX_DESIGN_WORKERS=4
# TEXTFIX_MAX_RUNS=300
